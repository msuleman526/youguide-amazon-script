# Copy this file to ".env" and fill in your real values.
# The .env file is gitignored so secrets never get committed.

# Amazon SP-API — Seller Central → Apps & Services → Develop Apps → View credentials
SP_API_REFRESH_TOKEN=
LWA_APP_ID=
LWA_CLIENT_SECRET=

# Amazon Seller account ID — Seller Central → Settings → Account Info
SELLER_ID=

# Google Sheet ID — the long string in the sheet URL between /d/ and /edit
SPREADSHEET_ID=
